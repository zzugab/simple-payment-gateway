# Application
APP_ENV=development
HTTP_ADDR=:8080
API_PORT=8080

# PostgreSQL (local development defaults only)
POSTGRES_DB=payment_lab
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment_dev_password
POSTGRES_PORT=5433

# Host-side Go runs use localhost. Docker Compose overrides this with the
# internal service hostname "postgres" for the API container.
DATABASE_URL=postgres://payment:payment_dev_password@localhost:5433/payment_lab?sslmode=disable
